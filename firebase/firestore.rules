rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auxiliar para verificar se o usuário é membro do workspace
    function isMember(workspaceId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }

    match /workspaces/{workspaceId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;

      // Orders: Membros podem ler e escrever
      match /orders/{orderId} {
        allow read, write: if isMember(workspaceId);
      }

      // Ledger Entries: Membros podem apenas ler
      match /ledger_entries/{entryId} {
        allow read: if isMember(workspaceId);
      }

      // Goals: Membros podem ler e escrever
      match /goals/{goalId} {
        allow read, write: if isMember(workspaceId);
      }

      // Categories: Membros podem ler e escrever
      match /categories/{categoryId} {
        allow read, write: if isMember(workspaceId);
      }

      // Planning: Membros podem ler e escrever
      match /planning/{planningId} {
        allow read, write: if isMember(workspaceId);

        // Planning Summaries: Membros podem apenas ler
        match /summaries/{summaryId} {
          allow read: if isMember(workspaceId);
        }
      }

      // Category Month Summaries: Membros podem apenas ler
      match /category_month_summaries/{summaryId} {
        allow read: if isMember(workspaceId);
      }

      // Accounts: Membros podem ler e escrever
      match /accounts/{accountId} {
        allow read, write: if isMember(workspaceId);

        // Account Balances: Membros podem apenas ler
        match /balance/{balanceId} {
          allow read: if isMember(workspaceId);
        }
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /workspaces_members/{memberId} {
      // O memberId é uid_workspaceId
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isMember(resource.data.workspaceId)
      );
    }

    match /invites/{inviteId} {
      // Qualquer um logado pode ler convites enviados para seu e-mail
      allow read: if request.auth != null && request.auth.token.email == resource.data.receiverEmail;
      
      // Apenas membros do workspace podem criar convites
      allow create: if request.auth != null && isMember(request.resource.data.workspace.id);
      
      // O destinatário pode atualizar o status do convite
      allow update: if request.auth != null && 
                    request.auth.token.email == resource.data.receiverEmail &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
