rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Auxiliar para verificar se o usuário é membro do workspace no Firestore
    function isMember(workspaceId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.members;
    }

    // Tipos aceitos para documentos financeiros: PDF, imagens, texto (CSV/TXT)
    // e application/octet-stream (OFX e uploads sem contentType inferido)
    function isAllowedDocumentType() {
      return request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('text/.*')
        || request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType == 'application/x-ofx';
    }

    // Regras para arquivos do workspace (onboarding, extratos, análise de contas, conciliação)
    match /workspaces/{workspaceId}/{folder}/{allPaths=**} {
      allow read: if isMember(workspaceId) &&
        folder in ['onboarding', 'account_analysis', 'reconciliation'];
      // Upload limitado a 20MB e a tipos de documento esperados.
      // (request.resource é null em deletes, então deletes ficam negados.)
      allow write: if isMember(workspaceId) &&
        folder in ['onboarding', 'account_analysis', 'reconciliation'] &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        isAllowedDocumentType();
    }

    // Regras para avatares de usuários (máx. 5MB, apenas imagens)
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Padrão: nega tudo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
